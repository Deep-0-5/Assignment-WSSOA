{
  "info": {
    "_postman_id": "lab7-api-gateway-collection",
    "name": "Lab 7 - API Gateway, Service Discovery & Cloud Deployment",
    "description": "Postman Collection for testing CampusConnect API Gateway routing, health checks, error handling (502 Bad Gateway), and microservices integration (User, Product, Order).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "Base URL of API Gateway (switch to cloud URL for cloud testing)"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Gateway - Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Gateway status is UP\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"UP\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Checks the operational status of the API Gateway and displays dynamic service registry routing table."
      }
    },
    {
      "name": "2. Gateway - Root Welcome & Registry",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Returns gateway information, endpoints list, and active service discovery URLs."
      }
    },
    {
      "name": "3. Users - Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data._id) {",
              "    pm.collectionVariables.set(\"userId\", jsonData.data._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice.johnson@campus.edu\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        },
        "description": "Routes POST /users through API Gateway to User Service."
      }
    },
    {
      "name": "4. Users - Get All Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        },
        "description": "Routes GET /users through API Gateway to User Service."
      }
    },
    {
      "name": "5. Users - Get User By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userId}}"]
        },
        "description": "Routes GET /users/:id through API Gateway to User Service."
      }
    },
    {
      "name": "6. Products - Create Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data._id) {",
              "    pm.collectionVariables.set(\"productId\", jsonData.data._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Campus Wireless Mouse\",\n  \"description\": \"Ergonomic rechargeable Bluetooth mouse\",\n  \"price\": 29.99,\n  \"category\": \"Electronics\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        },
        "description": "Routes POST /products through API Gateway to Product Service."
      }
    },
    {
      "name": "7. Products - Get All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        },
        "description": "Routes GET /products through API Gateway to Product Service."
      }
    },
    {
      "name": "8. Products - Get Product By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        },
        "description": "Routes GET /products/:id through API Gateway to Product Service."
      }
    },
    {
      "name": "9. Orders - Create Order (Inter-Service)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data._id) {",
              "    pm.collectionVariables.set(\"orderId\", jsonData.data._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        },
        "description": "Routes POST /orders through Gateway to Order Service, which in turn verifies user and product internally."
      }
    },
    {
      "name": "10. Orders - Get All Orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        },
        "description": "Routes GET /orders through API Gateway to Order Service."
      }
    },
    {
      "name": "11. Orders - Get Order By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["orders", "{{orderId}}"]
        },
        "description": "Routes GET /orders/:id through API Gateway to Order Service."
      }
    },
    {
      "name": "12. Error Handling - 502 Bad Gateway Test",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 502\", function () {",
              "    pm.response.to.have.status(502);",
              "});",
              "pm.test(\"Returns clear JSON error payload\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.eql(\"Bad Gateway\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        },
        "description": "Executed when upstream User Service is stopped. Gateway catches socket refusal and cleanly returns HTTP 502 Bad Gateway."
      }
    },
    {
      "name": "13. Error Handling - 404 Unmapped Route",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/unmapped-service",
          "host": ["{{baseUrl}}"],
          "path": ["unmapped-service"]
        },
        "description": "Tests gateway handling of non-existent route prefixes."
      }
    }
  ]
}
