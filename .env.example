# ============================================================================
# CAMPUSCONNECT ROOT ENVIRONMENT CONFIGURATION - LAB 7
# ============================================================================

# API Gateway Port (Exposed publicly)
GATEWAY_PORT=8000

# Backend Service Discovery URLs (for Docker internal network)
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# MongoDB Connection Strings
# Leave blank to use containerized local MongoDB instances (user-db, product-db, order-db)
# Or set your cloud MongoDB Atlas connection strings:
# USER_MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/userdb?retryWrites=true&w=majority
# PRODUCT_MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/productdb?retryWrites=true&w=majority
# ORDER_MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/orderdb?retryWrites=true&w=majority
